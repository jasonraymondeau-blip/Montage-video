# OpenAI API — optionnel pour le MVP (stubs utilisés si absent)
OPENAI_API_KEY=sk-...

# Répertoires de stockage local
UPLOAD_DIR=./uploads
OUTPUT_DIR=./processed

# Limites de traitement
MAX_INPUT_DURATION_SEC=300
TARGET_OUTPUT_DURATION_SEC=30
MAX_UPLOAD_SIZE_MB=500

# FFmpeg (auto-détecté via @ffmpeg-installer si non défini)
FFMPEG_PATH=
FFPROBE_PATH=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
